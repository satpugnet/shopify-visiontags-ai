# Shopify App Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app.up.railway.app
SHOPIFY_APP_HANDLE=visiontags
SCOPES=read_products,write_products

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (for BullMQ queue)
REDIS_URL=redis://default:password@host:6379

# AI (Claude Haiku via OpenRouter Anthropic Skin)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# Error Tracking (optional, disables if not set)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Optional: Dry run mode for stress testing (skips real API calls)
# VISION_DRY_RUN=true

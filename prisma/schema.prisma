generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Job {
  id           String    @id @default(uuid())
  shop         String
  collectionId String?
  industry     String?
  // Tag settings are SNAPSHOT here at scan start rather than read live from
  // ShopSettings. The worker rebuilds prompts out of process and "retry failed"
  // re-runs against the same job, so a live read would let one job span two
  // schema versions - after which the apply step can no longer tell which tag
  // keys it owns. Every Job creator snapshots; the worker reads Job only.
  tagFormat    String    @default("FREEFORM") // FREEFORM | KEY_VALUE
  tagSchema    Json?
  // ANY | UNTAGGED | TAGGED | MISSING_KEY:<Key>
  tagFilter    String?
  status       String    @default("QUEUED")
  totalItems   Int       @default(0)
  processed    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([shop])
  @@index([status])
}

model Product {
  id                       String    @id
  jobId                    String
  title                    String
  imageUrl                 String
  currentCategory          String?
  currentMetafields        Json?
  currentTags              String?
  suggestedMetafields      Json?
  suggestedTags            Json?
  suggestedDescription     String?
  suggestedSeoTitle        String?
  suggestedMetaDescription String?
  originalDescription      String?
  originalSeoTitle         String?
  originalMetaDescription  String?
  // The exact tag list last written to Shopify. Client-side tag edits are merged
  // at apply time and never persisted, so suggestedTags is NOT what was written -
  // without this, a correct revert of a merged apply is not computable.
  appliedTags              Json?
  // Values the AI proposed that the merchant's tag schema rejected, keyed by
  // schema key. Captured at analysis time because it cannot be backfilled later
  // without re-running the whole scan.
  rejectedTagAttributes    Json?
  syncedAt                 DateTime?
  status                   String    @default("PENDING")
  error                    String?
  createdAt                DateTime  @default(now())
  job                      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

model ShopSettings {
  id                  String    @id @default(uuid())
  shop                String    @unique
  plan                String    @default("FREE")
  industry            String?
  language            String    @default("auto")
  // Merchant-defined tag output. FREEFORM keeps the original phrase-style tags;
  // KEY_VALUE drives tags from tagSchema (see app/services/tagSchema.server.ts).
  tagFormat           String    @default("FREEFORM")
  tagSchema           Json?
  creditsUsed         Int       @default(0)
  creditLimit         Int       @default(50)
  billingPeriodStart  DateTime  @default(now())
  autoSyncNewProducts Boolean   @default(false)
  // Journey milestones
  firstSeenAt         DateTime?
  firstScanAt         DateTime?
  firstSyncAt         DateTime?
  lastActiveAt        DateTime?
  totalScans          Int       @default(0)
  totalSynced         Int       @default(0)
  uninstalledAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model UsageRecord {
  id        String   @id @default(uuid())
  shop      String
  month     String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([shop, month])
}

// Durable cross-run record of successfully analyzed products.
// Survives the per-scan delete/recreate of Product rows so scans can
// skip already-processed products instead of re-charging for them.
// productId is always the bare Shopify GID (gid://shopify/Product/123),
// never the UUID-suffixed variant used by webhook-created Product rows.
model ScannedProduct {
  shop      String
  productId String
  imageUrl  String
  scannedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@id([shop, productId])
  @@index([shop])
}
